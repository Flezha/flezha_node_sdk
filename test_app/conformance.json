{
  "runtime": "node",
  "sdk_lang": 4,
  "command": {
    "test": "node {artifact} {namespace}",
    "bench": "node {artifact} {namespace}"
  },
  "artifacts": {
    "test": ["index.mjs"],
    "bench": ["index.mjs"]
  },
  "build": {
    "test": "scripts/build-node-sdk.sh",
    "bench": "scripts/build-node-sdk.sh --release"
  },
  "connect_timeout_ms": 60000,
  "transports": ["uds", "quic"],
  "topology_surfaces": ["branch", "merge", "workflow", "sync_durability", "shorthand"],
  "dispatch": {
    "model": "event-loop",
    "detail": "Activations run on JavaScript event loops; the veneer owns its executor rather than libuv's pool.",
    "env": {
      "FLEZHA_NODE_WORKERS": "dispatch loops (0 \u2014 the default \u2014 runs on the main event loop)"
    }
  },
  "toolchain": "node --version",
  "deferred": [],
  "fixtures": {
    "runner_lifecycle": ["do_nothing", "compare_filter", "bench_echo"],
    "connect_discovery": ["do_nothing"],
    "graph_builder": [
      "sugar_static_cell",
      "static_cell",
      "mixed_operative",
      "hybrid_channel",
      "merged_input",
      "transform_chain",
      "cell_stress",
      "bench_keyed_nopersist"
    ],
    "shorthand": [
      "sugar_do_nothing",
      "sugar_store_input",
      "sugar_named_input",
      "sugar_workflow",
      "sugar_workflow_per_input",
      "sugar_state_only"
    ],
    "liveness": ["wedge_probe"],
    "retry_ladder": [
      "poison_probe",
      "bounded_mailbox_drop_nothing",
      "bounded_mailbox_drop_newest",
      "bounded_mailbox_drop_oldest"
    ],
    "state_persistence": [
      "store_input",
      "stateful_counter",
      "coalescing_counter",
      "persistence_off_counter",
      "resume_probe",
      "bench_keyed"
    ],
    "effectively_once": [
      "tier_store",
      "checkpoint_store",
      "checkpoint_batched_store",
      "bench_checkpoint"
    ],
    "cell_timers": ["session_timeout"],
    "correction_window": ["candle"],
    "keyed_channels": ["partition_relay"],
    "workflow": [
      "spawn_requester",
      "spawn_once_requester",
      "typed_once_workflow",
      "echo_workflow",
      "commit_block_workflow",
      "sync_durable_workflow",
      "optout_commit_block",
      "tier_commit_block_workflow",
      "saga_block_workflow",
      "outbox_block_workflow",
      "undo_outbox_workflow",
      "chat_loop_workflow",
      "stateless_loop_workflow",
      "chat_rewind_workflow",
      "reply_block_loop_workflow",
      "retry_workflow",
      "workflow_timer_refused",
      "static_cell_workflow",
      "branch_workflow",
      "diamond_workflow",
      "bench_chain_1",
      "bench_chain_4",
      "bench_chain_16",
      "bench_chain_optout_4",
      "bench_loop_workflow"
    ],
    "partitioned": ["partition_relay", "dynamic_cell"],
    "dynamic_cell": ["dynamic_cell"],
    "pool_wedge": ["wedge_probe"],
    "schema_evolution": ["schema_evolution_v1", "schema_evolution_v2"]
  },
  "docs": "docs/sdk/node_sdk.md"
}
